<?xml version="1.0" encoding="UTF-8"?>
<gdml>
  <define>
    <position name="origin" x="0" y="0" z="0" unit="cm"/>
  </define>
  <materials>
    <element name="hydrogen" formula="H" Z="1">
      <atom value="1.00794" unit="g/mole"/>
    </element>
    <element name="oxygen" formula="O" Z="8">
      <atom value="15.9994" unit="g/mole"/>
    </element>
    <material name="water" state="liquid">
      <D value="{density}" unit="g/cm3"/>
      <composite n="2" ref="hydrogen"/>
      <composite n="1" ref="oxygen"/>
    </material>
    <material name="vacuum" state="gas">
      <D value="1e-25" unit="g/cm3"/>
      <fraction n="1" ref="hydrogen"/>
    </material>
  </materials>
  <solids>
    <box name="world_box" x="{world_size}" y="{world_size}" z="{world_size}" lunit="cm"/>
    <sphere name="water_sphere" rmin="0" rmax="{radius}"
            startphi="0" deltaphi="360" starttheta="0" deltatheta="180" aunit="deg" lunit="cm"/>
    <sphere name="escape_shell" rmin="{escape_inner}" rmax="{escape_outer}"
            startphi="0" deltaphi="360" starttheta="0" deltatheta="180" aunit="deg" lunit="cm"/>
    <sphere name="guard_shell" rmin="{guard_inner}" rmax="{guard_outer}"
            startphi="0" deltaphi="360" starttheta="0" deltatheta="180" aunit="deg" lunit="cm"/>
  </solids>
  <structure>
    <!-- IDs 0 and 2 are AtRIS termination volumes; only ID 1 scores water.
         Both termination shells lie outside the source and water sphere. -->
    <volume name="escape">
      <materialref ref="vacuum"/>
      <solidref ref="escape_shell"/>
      <auxiliary auxtype="SensDet" auxvalue="0"/>
    </volume>
    <volume name="water_volume">
      <materialref ref="water"/>
      <solidref ref="water_sphere"/>
      <auxiliary auxtype="SensDet" auxvalue="1"/>
    </volume>
    <volume name="guard">
      <materialref ref="vacuum"/>
      <solidref ref="guard_shell"/>
      <auxiliary auxtype="SensDet" auxvalue="2"/>
    </volume>
    <volume name="world">
      <materialref ref="vacuum"/>
      <solidref ref="world_box"/>
      <physvol><volumeref ref="water_volume"/><positionref ref="origin"/></physvol>
      <physvol><volumeref ref="escape"/><positionref ref="origin"/></physvol>
      <physvol><volumeref ref="guard"/><positionref ref="origin"/></physvol>
    </volume>
  </structure>
  <setup name="water_phantom" version="1.0"><world ref="world"/></setup>
</gdml>
